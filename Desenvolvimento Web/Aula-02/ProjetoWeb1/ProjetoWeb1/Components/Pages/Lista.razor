@page "/ListaDeUsuarios"
@using ProjetoWeb1.Dados
@using ProjetoWeb1.Classes.Entidades
@using Microsoft.EntityFrameworkCore
@inject AlunoContext alunoContext
@rendermode InteractiveServer

<CabecalhoPagina/>

<section class="lista-alunos-section">
    <div class="lista-alunos-container">
        <div class="lista-alunos-cabecalho">
            <h2 class="lista-alunos-titulo">
                Lista de alunos
            </h2>
            <!--implementar logica para contagem em C#-->
            <span class="contador">
                @alunos.Count cadastrados
            </span>
        </div>
        <div class="tabela-w">
            <table class="tabela-alunos">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Curso</th>
                        <th>WiFI</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody class="tabela-alunos2">
                    <!--Exemplo estatico p/ visualização (remover quando implementar C#)-->
                    @foreach (var alunos in alunos)
                    {
                        <tr>
                            <td>@alunos.Nome</td>
                            <td>@ObterNomeCurso(alunos.cursoID)</td>
                            <td>@alunos.StatusWIFI</td>
                            <td>@alunos.StatusAction</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
      </div>
</section>



<h3>Lista</h3>
<Rodape/>
@code {

    private List<Aluno> alunos = new List<Aluno>();
    private Cursos cursos = new Cursos();

    protected override async Task OnInitializedAsync()
    {
        // carregar os alunos banco de dados
        alunos = await alunoContext.Alunos.ToListAsync();
    }
    private string ObterNomeCurso(int curso)
    {
        //retorna o nome do curso baseado no ID
        if(cursos.curso.TryGetValue(curso, out var nomeCurso))
        {
            return nomeCurso;
        }
        return "Curso não encontrado";
    }


}
